<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the Linux userland alive in the background: foreground service with
         a persistent notification (Termux's model). The WAKE_LOCK permission
         serves the conditional policy in PowerPolicy — the CPU is kept awake
         only while a managed service runs, a download/install/apt/backup is in
         flight, or the user opted in (Settings > Battery) with a live session.
         targetSdk 28: no FGS type and no runtime notification prompt required. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LinuxifyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linuxify">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Crash report screen: plain-Android (no Compose) so it can still draw
             when the crash is inside the Compose stack. Started only by the
             CrashReporter handler. -->
        <activity
            android:name=".runtime.CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crashreport" />

        <!-- Keeps the process alive while sessions/services run. Started by
             TerminalSessionRegistry.add / ServiceManager.start; stops itself
             when the last live session/service ends. -->
        <service
            android:name=".runtime.RuntimeForegroundService"
            android:exported="false" />
    </application>
</manifest>
